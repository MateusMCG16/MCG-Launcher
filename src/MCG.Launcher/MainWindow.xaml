<Window x:Class="MCG.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MCG.Launcher.ViewModels"
    Title="MCG Launcher">
  <Grid x:Name="Root" Background="{StaticResource AppBackgroundBrush}" RequestedTheme="Dark" Loaded="Root_Loaded">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowLayout">
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SidebarColumn.Width" Value="200" />
            <Setter Target="LibraryContent.Padding" Value="20,8,20,16" />
            <Setter Target="PageTitle.FontSize" Value="34" />
            <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="3" />
            <Setter Target="SourceFilter.(Grid.Row)" Value="1" />
            <Setter Target="SourceFilter.(Grid.Column)" Value="0" />
            <Setter Target="SortOrder.(Grid.Row)" Value="1" />
            <Setter Target="SortOrder.(Grid.Column)" Value="1" />
            <Setter Target="ActionsPanel.(Grid.Row)" Value="1" />
            <Setter Target="ActionsPanel.(Grid.Column)" Value="2" />
            <Setter Target="ActionsColumn.Width" Value="0" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1180" /></VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="Transparent" />
    <Grid Grid.Row="1" Padding="12,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="236" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

      <!-- Barra lateral -->
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="20">
        <Grid Padding="14,18,14,14">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,10">
              <!-- Same geometry as Assets/AppIcon.svg (100 × 100), drawn as vectors so it stays crisp. -->
              <Viewbox Width="38" Height="38" AutomationProperties.AccessibilityView="Raw">
                <Canvas Width="100" Height="100">
                  <!-- Hard gradient stop = the diagonal two-tone split, already clipped by the rounded corners.
                       The stroke separates the tile from the sidebar, which uses the same navy. -->
                  <Rectangle Canvas.Left="4" Canvas.Top="4" Width="92" Height="92" RadiusX="22" RadiusY="22" Stroke="#3A4D7A" StrokeThickness="3">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#14213D" Offset="0.5" /><GradientStop Color="#1C2C4F" Offset="0.5" />
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <Polygon Points="22,78 22,26 36,26 50,50 64,26 78,26 78,78 66,78 66,46 54,66 46,66 34,46 34,78" Fill="#E5E5E5" Opacity="0.4">
                    <Polygon.RenderTransform>
                      <TransformGroup><ScaleTransform ScaleX="0.88" ScaleY="0.88" /><TranslateTransform X="12" Y="6" /><SkewTransform AngleX="-10" /><TranslateTransform X="-3" Y="-4" /></TransformGroup>
                    </Polygon.RenderTransform>
                  </Polygon>
                  <Polygon Points="22,78 22,26 36,26 50,50 64,26 78,26 78,78 66,78 66,46 54,66 46,66 34,46 34,78" Fill="#E5E5E5">
                    <Polygon.RenderTransform>
                      <TransformGroup><ScaleTransform ScaleX="0.88" ScaleY="0.88" /><TranslateTransform X="12" Y="6" /><SkewTransform AngleX="-10" /><TranslateTransform X="4" Y="4" /></TransformGroup>
                    </Polygon.RenderTransform>
                  </Polygon>
                </Canvas>
              </Viewbox>
              <TextBlock Text="MCG" FontSize="15" FontWeight="Bold" CharacterSpacing="140" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="LibraryNav" Style="{StaticResource SidebarButtonStyle}" Click="Library_Click"
                Background="{StaticResource SelectedBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                AutomationProperties.ItemStatus="Seção atual">
              <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7FC;" FontSize="18" /><TextBlock Text="Jogos" FontWeight="SemiBold" /></StackPanel>
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource SidebarButtonStyle}" Click="Settings_Click">
              <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="18" /><TextBlock Text="Configurações" FontWeight="SemiBold" /></StackPanel>
            </Button>
          </StackPanel>
          <Button Grid.Row="2" Style="{StaticResource SidebarButtonStyle}" BorderBrush="Transparent" MinHeight="40" Padding="16,10" Click="About_Click">
            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="Sobre o launcher" FontSize="12" Foreground="{StaticResource MutedBrush}" /></StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Conteúdo -->
      <Grid x:Name="LibraryContent" Grid.Column="1" Padding="36,4,24,0" RowSpacing="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
          <TextBlock x:Name="PageTitle" Text="MCG Launcher" FontSize="42" FontWeight="SemiBold" CharacterSpacing="-20" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock x:Name="CountLabel" Text="Carregando biblioteca…" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="170" /><ColumnDefinition x:Name="ActionsColumn" Width="Auto" /></Grid.ColumnDefinitions>
          <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Buscar jogos" TextChanged="Search_TextChanged" AutomationProperties.Name="Buscar jogos" VerticalAlignment="Center">
            <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon>
          </AutoSuggestBox>
          <ComboBox x:Name="SourceFilter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Filtrar jogos">
            <ComboBoxItem Content="Todos os jogos" /><ComboBoxItem Content="Favoritos" /><ComboBoxItem Content="Jogados recentemente" />
            <ComboBoxItem Content="Steam" /><ComboBoxItem Content="Epic Games" /><ComboBoxItem Content="Adicionados por você" />
          </ComboBox>
          <ComboBox x:Name="SortOrder" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Ordenar jogos">
            <ComboBoxItem Content="Nome: A a Z" /><ComboBoxItem Content="Última abertura" /><ComboBoxItem Content="Adicionados agora" />
          </ComboBox>
          <StackPanel x:Name="ActionsPanel" Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="DetectButton" Click="Detect_Click" ToolTipService.ToolTip="Procurar jogos instalados na Steam e Epic Games" AutomationProperties.Name="Detectar jogos instalados">
              <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
            <Button ToolTipService.ToolTip="Mais ações" AutomationProperties.Name="Mais ações">
              <FontIcon Glyph="&#xE712;" FontSize="16" />
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem x:Name="LocalImagesButton" Text="Procurar imagens locais" Click="LocalImages_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="AddGameButton" Style="{StaticResource PrimaryButtonStyle}" Click="AddGame_Click">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Adicionar" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8">
          <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
          <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Atualizando biblioteca" />
        </StackPanel>
        <Grid Grid.Row="3">
          <GridView x:Name="GamesGrid" ItemsSource="{x:Bind Cards}" SelectionMode="None" IsItemClickEnabled="False"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,0,0,12" AutomationProperties.Name="Biblioteca de jogos">
            <GridView.ItemContainerStyle>
              <Style TargetType="GridViewItem">
                <Setter Property="Margin" Value="0,0,20,20" /><Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
              </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
              <DataTemplate x:DataType="vm:GameCard">
                <Border Width="200" Height="290" Background="{x:Bind ArtworkBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="16">
                  <Grid>
                    <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind InitialsVisibility, Mode=OneWay}" FontSize="52" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,70" />
                    <Image Source="{x:Bind Backdrop, Mode=OneWay}" Visibility="{x:Bind BackdropVisibility, Mode=OneWay}" Stretch="UniformToFill"
                        AutomationProperties.AccessibilityView="Raw" />
                    <Border Visibility="{x:Bind BackdropVisibility, Mode=OneWay}" Background="#B814213D" />
                    <Image AutomationProperties.Name="{x:Bind Name}" Source="{x:Bind Cover, Mode=OneWay}" Stretch="{x:Bind CoverStretch, Mode=OneWay}"
                        Width="{x:Bind CoverWidth, Mode=OneWay}" Height="{x:Bind CoverHeight, Mode=OneWay}" Margin="{x:Bind CoverMargin, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Tag="{x:Bind Entry}" Click="Favorite_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8" MinHeight="36" MinWidth="36"
                        Background="#99000000" BorderBrush="Transparent" CornerRadius="18"
                        ToolTipService.ToolTip="{x:Bind FavoriteLabel}" AutomationProperties.Name="{x:Bind FavoriteLabel}">
                      <FontIcon Glyph="{x:Bind FavoriteGlyph}" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                    </Button>
                    <StackPanel VerticalAlignment="Bottom" Background="{StaticResource CoverShadeBrush}" Padding="14,40,14,14" Spacing="8">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                        <TextBlock Text="{x:Bind Platform}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                      </StackPanel>
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Tag="{x:Bind Entry}" Click="Play_Click" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButtonStyle}" MinHeight="38" Padding="10,6"
                            AutomationProperties.Name="{x:Bind PlayLabel}" ToolTipService.ToolTip="{x:Bind LastPlayed}">
                          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="12" /><TextBlock Text="Jogar" /></StackPanel>
                        </Button>
                        <Button Grid.Column="1" MinHeight="38" MinWidth="38" Padding="8,6" Background="#33E5E5E5" BorderBrush="Transparent"
                            ToolTipService.ToolTip="Opções do jogo" AutomationProperties.Name="Opções do jogo">
                          <FontIcon Glyph="&#xE712;" FontSize="14" />
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuFlyoutItem Text="Editar jogo" Tag="{x:Bind Entry}" Click="Edit_Click" />
                              <MenuFlyoutItem Text="Abrir pasta" Tag="{x:Bind Entry}" Click="OpenFolder_Click" />
                              <MenuFlyoutSeparator />
                              <MenuFlyoutItem Text="Remover da biblioteca" Tag="{x:Bind Entry}" Click="Remove_Click" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </GridView.ItemTemplate>
          </GridView>
          <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Spacing="16">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="20" Padding="24" HorizontalAlignment="Center"><FontIcon Glyph="&#xE7FC;" FontSize="36" Foreground="{StaticResource AccentBrush}" /></Border>
            <TextBlock x:Name="EmptyTitle" Text="Sua próxima partida começa aqui" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="EmptyDescription" Text="Detecte os jogos da Steam e Epic ou adicione um executável ou atalho." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
